rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 랭킹: 누구나 읽기 가능, 각 플레이어는 자기 문서(익명 로그인 uid)만 쓰기 가능
    match /ranks/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'tag', 'best', 'total', 'cleared', 't'])
        && request.resource.data.nick is string
        && request.resource.data.nick.size() >= 1
        && request.resource.data.nick.size() <= 10
        && request.resource.data.tag is string
        && request.resource.data.tag.size() <= 8
        && request.resource.data.best is map
        && request.resource.data.best.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 30000
        && request.resource.data.cleared is number
        && request.resource.data.cleared <= 30
        && request.resource.data.t is number;
      allow delete: if false;
    }
    // 그 밖의 경로는 모두 막기
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
